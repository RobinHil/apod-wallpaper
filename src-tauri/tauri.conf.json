{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APOD Wallpaper",
  "mainBinaryName": "apod-wallpaper",
  "version": "0.2.4",
  "identifier": "com.rh.apod-wallpaper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "NASA Astronomy Picture of the Day as your wallpaper",
    "longDescription": "A background application that sets NASA's Astronomy Picture of the Day as your desktop wallpaper, once a day. Also supports a random pick from the archive and any specific date since 16 June 1995.",
    "copyright": "Copyright (c) 2026 Robin HILAIRE. APOD images with a copyright notice remain the property of their authors.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "gstreamer1.0-plugins-good",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
