<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background application: no Dock icon and no application menu. The
	     settings panel is opened by launching the app, and closing it leaves
	     the process running; a login agent starts it with --background, which
	     opens nothing at all. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Setting the desktop picture goes through an AppleScript event to
	     System Events. Without this key macOS denies the request outright on
	     a signed build instead of prompting the user for permission. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>APOD Wallpaper controls System Events to set your desktop picture.</string>
</dict>
</plist>
